{
  "ignorePatterns": [
    {
      "pattern": "{link}"
    },
    {
      "pattern": "twitter"
    },
    {
      "pattern": "http://localhost"
    },
    {
      "pattern": "https://www.greencarcongress.com"
    },
    {
      "pattern": "^#$"
    },
    {
      "pattern": "via.placeholder.com"
    },
    {
      "pattern": "openmotors.co"
    },
    {
      "pattern": "^/docs/"
    },
    {
      "pattern": "^/bounty"
    },
    {
      "pattern": "^/flight-tracking/"
    },
    {
      "pattern": "^/img/"
    },
    {
      "pattern": "^\\./[^)#]+(?:#[^)]+)?$"
    },
    {
      "pattern": "^\\.\\./[^)#]+(?:#[^)]+)?$"
    },
    {
      "pattern": "https://logs.px4.io"
    },
    {
      "pattern": "https://etherscan.io/address/"
    },
    {
      "pattern": "https://ree.auto/"
    },
    {
      "pattern": "https://autoware.org/open-ad-kit/"
    }
  ],
  "httpHeaders": [
    {
      "urls": [
        "https://docs.github.com/"
      ],
      "headers": {
        "Accept-Encoding": "zstd, br, gzip, deflate"
      }
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/images/",
      "replacement": "{{BASEURL}}/static/images/"
    },
    {
      "pattern": "^/([a-zA-Z._-]+)$",
      "replacement": "{{BASEURL}}/src/pages/$1.md"
    }
  ],
  "timeout": "5s"
}
