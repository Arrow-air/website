{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrowair.com/schemas/bounties.generated.schema.json",
  "title": "Arrow generated bounty board data",
  "type": "object",
  "additionalProperties": false,
  "$comment": "Keys are camelCased category names from disciplines.json (the canonical taxonomy). Skill values are the 43 canonical discipline names — kept in sync by scripts/sync-bounties.mjs, which validates against disciplines.json at sync time.",
  "required": ["engineering", "flightSystems", "flightOps", "manufacturing", "design", "content", "growth", "local", "operations"],
  "properties": {
    "engineering": { "$ref": "#/$defs/bountyRows" },
    "flightSystems": { "$ref": "#/$defs/bountyRows" },
    "flightOps": { "$ref": "#/$defs/bountyRows" },
    "manufacturing": { "$ref": "#/$defs/bountyRows" },
    "design": { "$ref": "#/$defs/bountyRows" },
    "content": { "$ref": "#/$defs/bountyRows" },
    "growth": { "$ref": "#/$defs/bountyRows" },
    "local": { "$ref": "#/$defs/bountyRows" },
    "operations": { "$ref": "#/$defs/bountyRows" }
  },
  "$defs": {
    "bountyRows": {
      "type": "array",
      "items": { "$ref": "#/$defs/bountyRow" }
    },
    "bountyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "status"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["OPEN", "CLAIMED", "EXPIRED", "CLOSED"] },
        "usdc": { "type": "string", "minLength": 1 },
        "arrow": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "minLength": 1 },
        "expectedWindow": { "type": "string", "minLength": 1 },
        "skills": {
          "type": "array",
          "items": {
            "enum": [
              "Mechanical",
              "CAD",
              "Electrical",
              "Aerodynamics",
              "Power",
              "Propulsion",
              "Certification",
              "Safety",
              "Firmware",
              "Software",
              "Controls",
              "Autonomy",
              "Telemetry",
              "Simulation",
              "Piloting",
              "Flight Test",
              "Maintenance",
              "Support",
              "Regulatory",
              "Missions",
              "3D Printing",
              "Machining",
              "Composites",
              "Assembly",
              "Sourcing",
              "Quality",
              "Industrial",
              "Interface",
              "Graphics",
              "Documentation",
              "Media",
              "Social Media",
              "Marketing",
              "Community",
              "Business Development",
              "Hosting",
              "Workshops",
              "Vertiports",
              "Governance",
              "Tokenomics",
              "Coordination",
              "Legal",
              "Tooling"
            ]
          },
          "uniqueItems": true
        },
        "posted": { "type": "string", "minLength": 1 },
        "issueUrl": { "type": "string", "format": "uri" },
        "applyUrl": { "type": "string", "format": "uri" },
        "detailUrl": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["usdc"] },
        { "required": ["arrow"] }
      ]
    }
  }
}
