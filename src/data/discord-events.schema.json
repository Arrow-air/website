{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrowair.com/schemas/discord-events.schema.json",
  "title": "Discord Scheduled Events",
  "description": "Discord Guild Scheduled Events synced hourly from the Discord API. Generated by .github/workflows/sync-discord-events.yml.",
  "type": "object",
  "required": ["fetchedAt", "guildId", "upcoming", "recent", "metadata"],
  "properties": {
    "fetchedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the data was fetched from Discord."
    },
    "guildId": {
      "type": "string",
      "description": "Discord guild (server) ID."
    },
    "upcoming": {
      "type": "array",
      "description": "Events with status SCHEDULED (1) or ACTIVE (2), sorted by start time ascending.",
      "items": { "$ref": "#/$defs/discordEvent" }
    },
    "recent": {
      "type": "array",
      "description": "Events with status COMPLETED (3) within the last 24 hours, sorted by start time descending (most recent first).",
      "items": { "$ref": "#/$defs/discordEvent" }
    },
    "metadata": {
      "type": "object",
      "required": ["totalEvents", "upcomingCount", "recentCount"],
      "properties": {
        "totalEvents": { "type": "integer", "description": "Total events returned by the API." },
        "upcomingCount": { "type": "integer", "description": "Number of upcoming/active events." },
        "recentCount": { "type": "integer", "description": "Number of recently completed events." }
      }
    }
  },
  "$defs": {
    "discordEvent": {
      "type": "object",
      "required": [
        "id", "name", "description", "scheduledStartTime", "startDate", "startTimeUtc",
        "privacyLevel", "status", "entityType", "userCount"
      ],
      "properties": {
        "id": { "type": "string", "description": "Discord snowflake ID." },
        "name": { "type": "string", "maxLength": 100, "description": "Event name." },
        "description": { "type": "string", "description": "Event description, may be empty." },
        "scheduledStartTime": { "type": "string", "format": "date-time" },
        "scheduledEndTime": { "type": ["string", "null"], "format": "date-time" },
        "startDate": { "type": "string", "description": "YYYY-MM-DD derived from scheduledStartTime." },
        "startTimeUtc": { "type": "string", "description": "HH:MM in UTC derived from scheduledStartTime." },
        "endDate": { "type": ["string", "null"], "description": "YYYY-MM-DD derived from scheduledEndTime." },
        "endTimeUtc": { "type": ["string", "null"], "description": "HH:MM in UTC derived from scheduledEndTime." },
        "privacyLevel": { "type": "integer", "enum": [2], "description": "2 = GUILD_ONLY." },
        "status": { "type": "integer", "enum": [1, 2, 3, 4], "description": "1=SCHEDULED, 2=ACTIVE, 3=COMPLETED, 4=CANCELLED." },
        "entityType": { "type": "integer", "enum": [1, 2, 3], "description": "1=STAGE_INSTANCE, 2=VOICE, 3=EXTERNAL." },
        "entityMetadata": { "type": ["object", "null"], "description": "External event location info." },
        "url": { "type": ["string", "null"], "description": "External event URL from entity_metadata.location." },
        "userCount": { "type": "integer", "minimum": 0, "description": "Number of users interested/subscribed." },
        "image": { "type": ["string", "null"], "description": "Cover image hash." },
        "recurrenceRule": { "type": ["object", "null"], "description": "Recurrence rule if the event repeats." }
      }
    }
  }
}